<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <script src="/baremux/index.js"></script>
    <script src="/epoxy/index.mjs" type="module"></script>
    <script src="/uv/uv.bundle.js"></script>
    <script src="/uv/uv.config.js"></script>
    <script src="/scram/scramjet.js"></script>
    <script src="/controller/controller.api.js"></script>
    <title>Xylara</title>
    <style>
        body {
            margin: 0;
            padding: 0;
            overflow: hidden;
            background: #000;
        }
        iframe {
            width: 100vw;
            height: 100vh;
            border: none;
        }
        .top-hover-trigger {
            position: fixed;
            top: 0;
            left: 50%;
            transform: translateX(-50%);
            width: 200px;
            height: 50px;
            z-index: 1000;
        }
        .search-container {
            display: none;
            position: absolute;
            top: 10px;
            left: 50%;
            transform: translateX(-50%);
            background-color: rgba(0, 0, 0, 0.8);
            padding: 10px 20px;
            border-radius: 15px;
            color: white;
            min-width: 300px;
            box-shadow: 0px 0px 15px rgba(0, 0, 0, 0.5);
            font-family: sans-serif;
            border: 1px solid #444;
        }
        .top-hover-trigger:hover .search-container, .search-container:focus-within {
            display: block;
        }
        #url-input {
            background: transparent;
            border: none;
            color: white;
            width: 100%;
            text-align: center;
            outline: none;
            font-size: 14px;
        }
    </style>
</head>
<body>
    <div class="top-hover-trigger">
        <div class="search-container">
            <input type="text" id="url-input" placeholder="Enter URL or Search...">
        </div>
    </div>
    <iframe id="Frame" src=""></iframe>
    <script>
        const frameEl = document.getElementById("Frame");
        const input = document.getElementById("url-input");

        let scramjetFrame = null;

        async function handleNavigation(query) {
            let url = query.trim();
            if (!url) return;

            if (!url.includes('.') || url.includes(' ')) {
                url = (localStorage.getItem('search') || 'https://www.google.com/search?q=') + encodeURIComponent(query);
            } else {
                if (!url.startsWith('http')) url = 'https://' + url;
            }

            const proxyType = localStorage.getItem('proxy') || 'ultraviolet';

            if (proxyType === 'ultraviolet') {
                const encoded = __uv$config.prefix + __uv$config.encodeUrl(url);
                localStorage.setItem("url", encoded);
                frameEl.src = encoded;
            } else {
                if (scramjetFrame) {
                    localStorage.setItem("url", url);
                    scramjetFrame.go(url);
                } else {
                    console.error("Scramjet frame not initialized yet.");
                }
            }
            input.value = url;
            input.blur();
        }

        async function init() {
            if ('serviceWorker' in navigator) {
                try {
                    await navigator.serviceWorker.register("/sw.js");
                    await navigator.serviceWorker.ready;
                } catch (err) {
                    console.error("SW Registration error:", err);
                }
            }

            try {
                const connection = new BareMux.BareMuxConnection("/baremux/worker.js");
                const wispUrl = localStorage.getItem("wisp") || ((location.protocol === "https:" ? "wss" : "ws") + "://" + location.host + "/wisp/");
                const transport = localStorage.getItem("transport") || "libcurl";
                const transportPath = transport === "epoxy" ? "/epoxy/index.mjs" : "/libcurl/index.mjs";
                
                if (await connection.getTransport() !== transportPath) {
                    await connection.setTransport(transportPath, [{ wisp: wispUrl }]);
                }
            } catch (err) {
                console.error("BareMux init error:", err);
            }

            try {
                await navigator.serviceWorker.ready;
                const serviceworker = navigator.serviceWorker.controller ?? (await navigator.serviceWorker.ready).active;
                let wispUrl = localStorage.getItem("wisp") || ((location.protocol === "https:" ? "wss" : "ws") + "://" + location.host + "/wisp/");

                let EpoxyTransport;
                if (self.EpoxyTransport) {
                    EpoxyTransport = self.EpoxyTransport.EpoxyTransport || self.EpoxyTransport.default || self.EpoxyTransport;
                } else {
                    const epoxyModule = await import('/epoxy/index.mjs');
                    EpoxyTransport = epoxyModule.EpoxyTransport || epoxyModule.default;
                }

                const transport = new EpoxyTransport({ wisp: wispUrl });
                await transport.init();

                const { Controller } = $scramjetController;
                const { defaultConfig } = $scramjet;

                const scramjet = new Controller({
                    serviceworker,
                    transport,
                    scramjetConfig: defaultConfig
                });

                await scramjet.wait();
                window.sj = scramjet;

                scramjetFrame = scramjet.createFrame(frameEl);

                const savedUrl = localStorage.getItem("url");
                const proxyType = localStorage.getItem('proxy') || 'ultraviolet';

                if (savedUrl) {
                    if (proxyType === 'scramjet' || !savedUrl.startsWith(__uv$config.prefix)) {
                        const target = savedUrl.startsWith("http") ? savedUrl : "https://example.com";
                        scramjetFrame.go(target);
                        input.value = target;
                    } else {
                        frameEl.src = savedUrl;
                        input.value = savedUrl;
                    }
                }
            } catch (error) {
                console.error("Scramjet init error in search page:", error);
            }
        }

        document.addEventListener("DOMContentLoaded", () => {
            init();
        });

        input.addEventListener("keydown", (e) => {
            if (e.key === "Enter") handleNavigation(input.value);
        });
    </script>
</body>
</html>
